{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zerot",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lms",
      "database_id": "6f86511c-06ea-4391-9b37-9a6912007d7b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "lms",
      "jurisdiction": "eu"
    }
  ],
  "env": {
    "production": {
      "route": "api.zerot.com/*"
    }
  },
  "observability": {
    "enabled": true
  },
  "compatibility_flags": []
}
