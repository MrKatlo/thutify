rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    // Platform Super Admin Bypass
    function isPlatformAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPlatformAdmin == true;
    }

    // Multi-tenant isolation helpers
    function hasMembership(institutionId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/institutionUsers/$(request.auth.uid + '_' + institutionId));
    }

    function getMembership(institutionId) {
      return get(/databases/$(database)/documents/institutionUsers/$(request.auth.uid + '_' + institutionId)).data;
    }

    function instRole(institutionId) {
      return getMembership(institutionId).role;
    }

    function instStatus(institutionId) {
      return getMembership(institutionId).status;
    }

    function isInstActiveMember(institutionId) {
      return hasMembership(institutionId) && instStatus(institutionId) == 'active';
    }

    // Admin role includes both general 'admin' and school owner 'owner' memberships
    function isInstAdmin(institutionId) {
      return isInstActiveMember(institutionId) && 
             (instRole(institutionId) == 'admin' || instRole(institutionId) == 'owner');
    }

    function isInstTeacher(institutionId) {
      return isInstActiveMember(institutionId) && instRole(institutionId) == 'teacher';
    }

    function isInstStudent(institutionId) {
      return isInstActiveMember(institutionId) && instRole(institutionId) == 'student';
    }

    // Enrollment Validation helper (standardized document ID: studentId_courseId)
    function isEnrolled(courseId) {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)) &&
             (get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'active' ||
              get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'completed');
    }

    // --- COLLECTION RULES ---

    // 1. institutions
    match /institutions/{instId} {
      allow get: if true; // Publicly get credentials for branded route loading
      allow list: if isPlatformAdmin();
      allow create: if isSignedIn();
      allow update: if isPlatformAdmin() || (isSignedIn() && resource.data.ownerUserId == request.auth.uid && request.resource.data.ownerUserId == request.auth.uid);
      allow delete: if isPlatformAdmin();
    }

    // 2. users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isPlatformAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isPlatformAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isPlatformAdmin();
    }

    // 3. institutionUsers (format: userId_institutionId)
    match /institutionUsers/{membershipId} {
      allow read: if isPlatformAdmin() || 
                    (isSignedIn() && (resource.data.userId == request.auth.uid || isInstAdmin(resource.data.institutionId)));
      allow create: if isSignedIn() && 
                    (request.resource.data.userId == request.auth.uid || isInstAdmin(request.resource.data.institutionId));
      allow update: if isPlatformAdmin() || isInstAdmin(resource.data.institutionId);
      allow delete: if isPlatformAdmin() || isInstAdmin(resource.data.institutionId);
    }

    // 4. studentApplications
    match /studentApplications/{appId} {
      allow read: if isPlatformAdmin() || 
                    (isSignedIn() && (resource.data.userId == request.auth.uid || isInstAdmin(resource.data.institutionId)));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isPlatformAdmin() || isInstAdmin(resource.data.institutionId);
      allow delete: if isPlatformAdmin() || isInstAdmin(resource.data.institutionId);
    }

    // --- EXISTING DASHBOARD COLLECTIONS SCOPED BY INSTITUTIONID ---

    match /courses/{courseId} {
      allow read: if isPlatformAdmin() || 
                    isInstAdmin(resource.data.institutionId) || 
                    (isInstTeacher(resource.data.institutionId) && resource.data.teacherId == request.auth.uid) ||
                    (isInstStudent(resource.data.institutionId) && isEnrolled(courseId));
      allow create: if isPlatformAdmin() || isInstAdmin(request.resource.data.institutionId);
      allow update: if isPlatformAdmin() || 
                    isInstAdmin(resource.data.institutionId) || 
                    (isInstTeacher(resource.data.institutionId) && resource.data.teacherId == request.auth.uid);
      allow delete: if isPlatformAdmin() || isInstAdmin(resource.data.institutionId);
    }
    
    match /enrollments/{enrollId} {
      allow read: if isPlatformAdmin() || 
                    isInstAdmin(resource.data.institutionId) || 
                    (isInstTeacher(resource.data.institutionId) && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid) ||
                    (isInstStudent(resource.data.institutionId) && resource.data.studentId == request.auth.uid);
      allow create: if isPlatformAdmin() || 
                    isInstAdmin(request.resource.data.institutionId) || 
                    (isSignedIn() && enrollId.startsWith(request.auth.uid) && request.resource.data.studentId == request.auth.uid);
      allow update: if isPlatformAdmin() || isInstAdmin(resource.data.institutionId);
      allow delete: if isPlatformAdmin() || isInstAdmin(resource.data.institutionId);
    }

    match /students/{userId} {
      allow read: if isPlatformAdmin() || 
                    (isSignedIn() && (request.auth.uid == userId || isInstAdmin(resource.data.institutionId)));
      allow write: if isPlatformAdmin() || 
                     (isSignedIn() && (request.auth.uid == userId || isInstAdmin(request.resource.data.institutionId)));
    }

    match /teachers/{userId} {
      allow read: if isPlatformAdmin() || 
                    (isSignedIn() && (request.auth.uid == userId || isInstAdmin(resource.data.institutionId)));
      allow write: if isPlatformAdmin() || 
                     (isSignedIn() && (request.auth.uid == userId || isInstAdmin(request.resource.data.institutionId)));
    }

    match /payments/{paymentId} {
      allow read: if isPlatformAdmin() || 
                    isInstAdmin(resource.data.institutionId) || 
                    (isInstStudent(resource.data.institutionId) && resource.data.studentId == request.auth.uid);
      allow create: if isPlatformAdmin() || isInstAdmin(request.resource.data.institutionId);
      allow update: if isPlatformAdmin() || isInstAdmin(resource.data.institutionId);
      allow delete: if isPlatformAdmin() || isInstAdmin(resource.data.institutionId);
    }

    match /attendance/{attendanceId} {
      allow read: if isPlatformAdmin() || 
                    isInstAdmin(resource.data.institutionId) || 
                    (isInstStudent(resource.data.institutionId) && resource.data.studentId == request.auth.uid) ||
                    (isInstTeacher(resource.data.institutionId) && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid);
      allow write: if isPlatformAdmin() || 
                    isInstAdmin(resource.data.institutionId) || 
                    (isInstTeacher(resource.data.institutionId) && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.teacherId == request.auth.uid);
    }

    match /submissions/{submissionId} {
      allow read: if isPlatformAdmin() || 
                    isInstAdmin(resource.data.institutionId) || 
                    (isInstStudent(resource.data.institutionId) && resource.data.studentId == request.auth.uid) ||
                    (isInstTeacher(resource.data.institutionId) && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid);
      allow create: if isPlatformAdmin() || 
                    isInstAdmin(request.resource.data.institutionId) || 
                    (isInstStudent(resource.data.institutionId) && request.resource.data.studentId == request.auth.uid && isEnrolled(request.resource.data.courseId));
      allow update: if isPlatformAdmin() || 
                    isInstAdmin(resource.data.institutionId) || 
                    (isInstStudent(resource.data.institutionId) && resource.data.studentId == request.auth.uid && request.resource.data.studentId == request.auth.uid) ||
                    (isInstTeacher(resource.data.institutionId) && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid);
      allow delete: if isPlatformAdmin() || isInstAdmin(resource.data.institutionId);
    }

    match /assignments/{assignmentId} {
      allow read: if isPlatformAdmin() || 
                    isInstAdmin(resource.data.institutionId) || 
                    (isInstTeacher(resource.data.institutionId) && resource.data.teacherId == request.auth.uid) ||
                    (isInstStudent(resource.data.institutionId) && isEnrolled(resource.data.courseId));
      allow write: if isPlatformAdmin() || 
                    isInstAdmin(request.resource.data.institutionId) || 
                    (isInstTeacher(resource.data.institutionId) && request.resource.data.teacherId == request.auth.uid);
    }

    match /liveClasses/{classId} {
      allow read: if isPlatformAdmin() || isInstActiveMember(resource.data.institutionId);
      allow write: if isPlatformAdmin() || isInstAdmin(request.resource.data.institutionId) || isInstTeacher(request.resource.data.institutionId);
    }

    match /announcements/{announcementId} {
      allow read: if isPlatformAdmin() || isInstActiveMember(resource.data.institutionId);
      allow write: if isPlatformAdmin() || isInstAdmin(request.resource.data.institutionId) || isInstTeacher(request.resource.data.institutionId);
    }

    match /lessonProgress/{progressId} {
      allow read: if isPlatformAdmin() || 
                    isInstAdmin(resource.data.institutionId) || 
                    (isSignedIn() && progressId.startsWith(request.auth.uid)) ||
                    (isInstTeacher(resource.data.institutionId) && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid);
      allow write: if isPlatformAdmin() || 
                    isInstAdmin(request.resource.data.institutionId) || 
                    (isSignedIn() && progressId.startsWith(request.auth.uid));
    }

    match /settings/{settingId} {
      allow read: if isPlatformAdmin() || isInstActiveMember(resource.data.institutionId);
      allow write: if isPlatformAdmin() || isInstAdmin(request.resource.data.institutionId);
    }
  }
}
