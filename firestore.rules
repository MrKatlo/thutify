rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Role Checks
    function isAdmin() {
      return isSignedIn() && getProfile().role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && getProfile().role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getProfile().role == 'student';
    }

    // Enrollment Validation helper (standardized document ID: studentId_courseId)
    function isEnrolled(courseId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)) &&
        (get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'active' ||
         get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'completed');
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // Allow Admin to create any profile; allow new users to create their own profile if status is active
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == userId && request.resource.data.status == 'active');
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
    
    match /invites/{inviteId} {
      allow read: if true; // Public read needed for verifyInvite token checks
      allow create: if isAdmin();
      // Allow Admin or user activating invite (marking as used) to update it
      allow update: if isAdmin() || (request.resource.data.status == 'used' && resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAdmin() || 
                    (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                    (isStudent() && isEnrolled(courseId)); // Enrolled students only!
      allow create: if isAdmin();
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /enrollments/{enrollId} {
      allow read: if isAdmin() || 
                    (isTeacher() && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid) ||
                    (isStudent() && resource.data.studentId == request.auth.uid);
      // Student can create their own active enrollment during invite activation
      allow create: if isAdmin() || (isSignedIn() && enrollId.startsWith(request.auth.uid) && request.resource.data.studentId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /students/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /teachers/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || 
                    (isStudent() && resource.data.studentId == request.auth.uid) ||
                    (isTeacher() && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid);
      allow write: if isAdmin() || 
                    (isTeacher() && get(/databases/$(database)/documents/courses/$(request.resource.data.courseId)).data.teacherId == request.auth.uid);
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin() || 
                    (isStudent() && resource.data.studentId == request.auth.uid) ||
                    (isTeacher() && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid);
      allow create: if isAdmin() || 
                    (isStudent() && request.resource.data.studentId == request.auth.uid && isEnrolled(request.resource.data.courseId));
      allow update: if isAdmin() || 
                    (isStudent() && resource.data.studentId == request.auth.uid && request.resource.data.studentId == request.auth.uid) ||
                    (isTeacher() && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin() || 
                    (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                    (isStudent() && isEnrolled(resource.data.courseId));
      allow write: if isAdmin() || 
                    (isTeacher() && request.resource.data.teacherId == request.auth.uid);
    }

    match /liveClasses/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /lessonProgress/{progressId} {
      allow read: if isAdmin() ||
                    (isSignedIn() && progressId.startsWith(request.auth.uid)) ||
                    (isTeacher() && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid);
      allow write: if isAdmin() || (isSignedIn() && progressId.startsWith(request.auth.uid));
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /applications/{applicationId} {
      allow create: if true; // Any prospective user can apply
      allow read, write: if isAdmin();
    }
  }
}
