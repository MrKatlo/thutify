rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getProfile().role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && getProfile().role == 'teacher';
    }

    // Match Blocks
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }

    // Upgraded dynamic collections
    match /lessonProgress/{progressId} {
      allow read, write: if isSignedIn();
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /submissions/{submissionId} {
      allow read, write: if isSignedIn();
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /quizAttempts/{attemptId} {
      allow read, write: if isSignedIn();
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /liveClasses/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }
  }
}
