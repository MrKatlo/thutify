rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Definitions
    function isSignedIn() {
      return request.auth != null;
    }

    function getProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getProfile().role == 'admin';
    }

    function isTeacher() {
      return isSignedIn() && getProfile().role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getProfile().role == 'student';
    }

    function isEnrolled(courseId) {
      return isSignedIn() && exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId));
    }
    
    // Better enrollment check for dynamic IDs
    function checkEnrollment(courseId) {
      return isSignedIn() && 
        getAfter(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'active' ||
        get(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)).data.status == 'active';
    }

    // Match Blocks
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if false; // Only via Admin/Functions (simulated in UI but should be blocked here)
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }
    
    match /invites/{inviteId} {
      allow read: if true; // Needed for verifyInvite on AuthPage
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAdmin() || 
                    (isTeacher() && resource.data.teacherId == request.auth.uid) ||
                    isStudent(); // Students can see titles, but content is protected in sub-collections
      allow create: if isAdmin();
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    match /enrollments/{enrollId} {
      allow read: if isAdmin() || 
                    (isTeacher() && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid) ||
                    (isStudent() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /students/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /teachers/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isTeacher();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }

    // Lesson content and progress
    match /lessons/{lessonId} {
      allow read: if isAdmin() || 
                    (isTeacher() && get(/databases/$(database)/documents/courses/$(resource.data.courseId)).data.teacherId == request.auth.uid) ||
                    (isStudent()); // Content usually restricted via enrollment check in frontend, but could be tighter here
    }

    match /applications/{applicationId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }
  }
}
